# issue-drain profile: Not-Every-Mom/kindred-mama-ai
# Sourced by scripts/lib.sh as shell. Every key is explained in references/profile.md.

BASE_BRANCH="develop"

# An issue carrying any of these is left out at intake, with the label as the reason.
HOLD_LABELS="needs-human agent-needs-human ready-for-human needs-product-input needs-discussion design-needed blocked belongs-in-nem-app epic wont-fix wontfix duplicate invalid question"

CLAIM_LABEL="agent-in-progress"
BLOCKED_LABEL="needs-human"
TRACKER_LABEL="issue-drain"

# Highest priority first. An issue with none of these sorts last.
PRIORITY_LABELS="p0 CRITICAL p1 priority/high HIGH p2 priority/medium MEDIUM p3 LOW"

# Matched against repo-relative paths, ignoring case.
# Protected: an issue whose fix lives here goes to "needs a person" and no unit runs.
PROTECTED_PATH_RE='^(\.github/(workflows|actions)/|\.husky/|\.claude/|infra/|ci/)|^(firestore|storage)\.rules$'
# Risk: the unit runs, opens its PR, then waits for a named reviewer. Never clustered.
RISK_PATH_RE='(^|/)[^/]*(crisis|clinical|billing|stripe|auth)[^/]*(/|$)'

TRUSTED_ASSOCIATIONS="OWNER MEMBER COLLABORATOR"

INTAKE_CAP=40
STALE_CLAIM_DAYS=3

# Run in the checkout with ISSUE_TITLE and ISSUE_BODY set; prints JSON with
# "verdict" (app | mixed | kma | none) and "appPaths". "app" means every path
# the issue names has moved to Not-Every-Mom/nem-app, so the issue is left out.
ISSUE_CLASSIFIER="node scripts/split-issue-triage.cjs"

CLUSTER_MAX_ISSUES=4
CLUSTER_MAX_LINES=400

EVIDENCE_LINE_SLACK=3
EVIDENCE_MIN_QUOTE=8

# Shown in the tracker header. Units arrive with the unit-and-gate build;
# until then triage is the only part that runs.
UNIT_PERMISSIONS="triage readers: Read, Grep, Glob only. Units: not built yet"
