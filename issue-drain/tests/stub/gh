#!/bin/sh
# A stand-in for gh in the CLI tests. The harness puts this folder first on
# PATH. Every call is appended to $GH_STUB_LOG, one line of arguments each, so
# a test can assert what was called, and that nothing was.
#
# Files in $GH_STUB_DIR steer it:
#   fail                  every call exits 1
#   graphql-<n>.json      answer to `gh api graphql ... -F number=<n>`; without
#                         the file the answer is GitHub's NOT_FOUND body and
#                         exit 1, as gh gives for a number that is no issue
#   graphql-<n>.err.json  printed for that call, which then exits 1 (a request
#                         that failed; the file may be empty)
#   issue-list.txt        answer to `gh issue list`
#   tracker-list.json     answer to `gh issue list ... --json number,url,body`
#                         (publish looking for a tracker it already made);
#                         without the file the answer is []
#   fail-list             `gh issue list` exits 1
#   issue-view-<n>.json   answer to `gh issue view <n>`
#   issue-view-<n>.next.json  the answer from the second view of <n> onward
#                         (someone edited it after the first read)
#   once-issue-view-<n>   a shell script run on the first `gh issue view <n>`,
#                         before the answer (something changed elsewhere
#                         while the caller was at work)
#   closed-<n>            written by `gh issue close <n>`; from then on
#                         `gh issue view <n>` reports the state CLOSED
#   fail-create           `gh issue create` exits 1
#   fail-comment          `gh issue comment` exits 1
#   labels.txt            answer to `gh label list`, one name per line
#   pr-view-<n>.json      answer to `gh pr view <n>`
#   pr-view-<n>.after-merge.json  the answer to `gh pr view <n>` once `gh pr
#                         merge <n>` has exited 0 (a merge queue leaves the PR
#                         OPEN); without the file that view fails
#   protection.json       answer to `gh api repos/<o>/<r>/branches/<b>/protection`
#   protection.unprotected  that call answers GitHub's 404 "Branch not protected"
#                         body (on stdout, as gh prints it) and exits 1
#   rules.json            answer to `gh api repos/<o>/<r>/rules/branches/<b>...
#                         --paginate` (one array, or several one after another);
#                         without the file, []
#   fail-rules            that call exits 1
#   compare.json          answer to `gh api repos/<o>/<r>/compare/<b>...<sha>`
#   compare-reviewed.json answer to a compare whose first side is not the base
#                         branch (is the reviewed commit an ancestor of the head)
#   check-runs.json       answer to `gh api repos/<o>/<r>/commits/<sha>/check-runs`
#                         (one object, or several one after another); a missing
#                         file fails the call
#   statuses.json         answer to `gh api repos/<o>/<r>/commits/<sha>/statuses`
#                         (default: an empty list)
#   app-<slug>.json       answer to `gh api apps/<slug>`; a missing file fails
#                         the call
#   merged-<n> and pr-view-<n>.after-merge.json: see above; `gh pr merge <n>
#                         --disable-auto` writes disable-auto-<n>, and from then
#                         on the view is pr-view-<n>.after-disable.json when it
#                         exists
#   fail-disable-auto     `gh pr merge --disable-auto` exits 1
#   merge-queue.json      answer to the graphql read of `isInMergeQueue`; without
#                         the file that read fails
#   comments.json         answer to `gh api repos/<o>/<r>/issues/<n>/comments`
#                         (one array, or several one after another, as
#                         `--paginate` prints them); without the file the call
#                         fails
#   timeline-<n>.json     answer to `gh api repos/<o>/<r>/issues/<n>/timeline`
#                         (what `--paginate` prints: one JSON array, or
#                         several one after another); without the file, []
#   fail-timeline         the timeline read exits 1
#   fail-add-label        `gh issue edit ... --add-label` exits 1
#   fail-merge            `gh pr merge` exits 1
#   fail-update-branch    `gh pr update-branch` exits 1 (it changes nothing
#                         otherwise: a test makes the new head itself and
#                         names it in pr-view-<n>.json)
#   fail-thread           the thread-reply and thread-resolve mutations exit 1
# GH_STUB_NEW_PR          the number `gh pr create` reports (default 901)
# GH_STUB_NEW_ISSUE       the number `gh issue create` reports (default 900)
# GH_STUB_CLOSE_NOOP=1    `gh issue close` exits 0 but closes nothing
#
# A call it does not know exits 9, so a test cannot pass on a call nobody
# thought about. A call made with GH_HOST other than github.com exits 8: the
# repo is named owner/repo, and only a pinned host says which GitHub that is.
dir="${GH_STUB_DIR:?the gh stub needs GH_STUB_DIR}"
if [ -n "${GH_STUB_LOG:-}" ]; then printf '%s\n' "$*" >> "$GH_STUB_LOG"; fi
if [ "${GH_HOST:-}" != "github.com" ]; then echo "gh stub: GH_HOST is '${GH_HOST:-}'" >&2; exit 8; fi
if [ -e "$dir/fail" ]; then echo "gh stub: told to fail" >&2; exit 1; fi

answer() { # answer <file>: print it, or fail the way gh does for a missing thing
  if [ -f "$dir/$1" ]; then cat "$dir/$1"; else echo "gh stub: no $1" >&2; exit 1; fi
}

case "${1:-} ${2:-}" in
  "api graphql")
    case "$*" in
      *addPullRequestReviewThreadReply* | *resolveReviewThread*)
        if [ -e "$dir/fail-thread" ]; then echo "gh stub: thread call failed" >&2; exit 1; fi
        echo '{"data":{}}'; exit 0 ;;
    esac
    case "$*" in
      *isInMergeQueue*) answer merge-queue.json; exit 0 ;;
    esac
    n=""
    for arg in "$@"; do
      case "$arg" in number=*) n="${arg#number=}" ;; esac
    done
    if [ -f "$dir/graphql-$n.err.json" ]; then
      cat "$dir/graphql-$n.err.json"; exit 1
    elif [ -f "$dir/graphql-$n.json" ]; then
      cat "$dir/graphql-$n.json"
    else
      printf '%s\n' '{"data":{"repository":{"issue":null}},"errors":[{"type":"NOT_FOUND","path":["repository","issue"],"message":"Could not resolve to an Issue."}]}'
      exit 1
    fi ;;
  "issue list")
    if [ -e "$dir/fail-list" ]; then echo "gh stub: list failed" >&2; exit 1; fi
    case "$*" in
      *"--json number,url,body"*)
        if [ -f "$dir/tracker-list.json" ]; then cat "$dir/tracker-list.json"; else echo "[]"; fi ;;
      *)
        if [ -f "$dir/issue-list.txt" ]; then cat "$dir/issue-list.txt"; fi ;;
    esac ;;
  "issue view")
    if [ -f "$dir/once-issue-view-$3" ]; then
      mv "$dir/once-issue-view-$3" "$dir/ran-issue-view-$3"
      sh "$dir/ran-issue-view-$3" >/dev/null 2>&1 || { echo "gh stub: the once script failed" >&2; exit 7; }
    fi
    if [ -e "$dir/closed-$3" ] && [ -f "$dir/issue-view-$3.json" ]; then
      sed 's/"state" *: *"[A-Z]*"/"state":"CLOSED"/' "$dir/issue-view-$3.json"
    elif [ -f "$dir/issue-view-$3.next.json" ] && [ -e "$dir/viewed-$3" ]; then
      cat "$dir/issue-view-$3.next.json"
    elif [ -f "$dir/issue-view-$3.next.json" ]; then
      : > "$dir/viewed-$3"
      answer "issue-view-$3.json"
    else
      answer "issue-view-$3.json"
    fi ;;
  "issue create")
    if [ -e "$dir/fail-create" ]; then echo "gh stub: create failed" >&2; exit 1; fi
    echo "https://github.com/example/tidepool/issues/${GH_STUB_NEW_ISSUE:-900}" ;;
  "issue close")
    if [ "${GH_STUB_CLOSE_NOOP:-}" != "1" ]; then : > "$dir/closed-$3"; fi ;;
  "issue comment")
    if [ -e "$dir/fail-comment" ]; then echo "gh stub: comment failed" >&2; exit 1; fi ;;
  "pr create")
    echo "https://github.com/example/tidepool/pull/${GH_STUB_NEW_PR:-901}" ;;
  "pr view")
    if [ -e "$dir/disable-auto-$3" ] && [ -f "$dir/pr-view-$3.after-disable.json" ]; then answer "pr-view-$3.after-disable.json"
    elif [ -e "$dir/merged-$3" ]; then answer "pr-view-$3.after-merge.json"; else answer "pr-view-$3.json"; fi ;;
  "pr update-branch")
    if [ -e "$dir/fail-update-branch" ]; then echo "gh stub: update-branch failed" >&2; exit 1; fi ;;
  "pr merge")
    case "$*" in
      *--disable-auto*)
        if [ -e "$dir/fail-disable-auto" ]; then echo "gh stub: disable-auto failed" >&2; exit 1; fi
        : > "$dir/disable-auto-$3"; exit 0 ;;
    esac
    if [ -e "$dir/fail-merge" ]; then echo "gh stub: merge failed" >&2; exit 1; fi
    : > "$dir/merged-$3" ;;
  "api apps/"*) answer "app-${2#apps/}.json" ;;
  "api repos/"*)
    case "$2" in
      */protection)
        if [ -e "$dir/protection.unprotected" ]; then
          echo '{"message":"Branch not protected","documentation_url":"https://docs.github.com/rest/branches/branch-protection#get-branch-protection","status":"404"}'
          echo "gh stub: Branch not protected (HTTP 404)" >&2; exit 1
        fi
        answer protection.json ;;
      */rules/branches/*)
        if [ -e "$dir/fail-rules" ]; then echo "gh stub: rules failed" >&2; exit 1; fi
        if [ -f "$dir/rules.json" ]; then cat "$dir/rules.json"; else echo "[]"; fi ;;
      */compare/develop...*) answer compare.json ;;
      */compare/*) answer compare-reviewed.json ;;
      */commits/*/check-runs*) answer check-runs.json ;;
      */commits/*/statuses*)
        if [ -f "$dir/statuses.json" ]; then cat "$dir/statuses.json"; else echo "[]"; fi ;;
      */issues/*/comments*) answer comments.json ;;
      */issues/*/timeline*)
        if [ -e "$dir/fail-timeline" ]; then echo "gh stub: timeline failed" >&2; exit 1; fi
        t="${2#*/issues/}"
        if [ -f "$dir/timeline-${t%%/*}.json" ]; then cat "$dir/timeline-${t%%/*}.json"; else echo "[]"; fi ;;
      *) echo "gh stub: unexpected call: $*" >&2; exit 9 ;;
    esac ;;
  "issue edit")
    case "$*" in
      *--add-label*) if [ -e "$dir/fail-add-label" ]; then echo "gh stub: add-label failed" >&2; exit 1; fi ;;
    esac ;;
  "run rerun") ;;
  "pr edit") ;;
  "label create") ;;
  "label list")
    if [ -f "$dir/labels.txt" ]; then cat "$dir/labels.txt"; fi ;;
  *)
    echo "gh stub: unexpected call: $*" >&2
    exit 9 ;;
esac
