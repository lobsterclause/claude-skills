# issue-drain profile for the "tidepool" fixture repo (evals and script tests).
# Point ISSUE_DRAIN_PROFILE at this file; ISSUE_DRAIN_REPO is example/tidepool.

BASE_BRANCH="develop"
HOLD_LABELS="needs-human blocked wontfix"
CLAIM_LABEL="agent-in-progress"
BLOCKED_LABEL="needs-human"
TRACKER_LABEL="issue-drain"
PRIORITY_LABELS="p0 p1 p2 p3"
PROTECTED_PATH_RE='^(\.github/workflows/|\.husky/|\.claude/)'
RISK_PATH_RE='(^|/)[^/]*(crisis|billing)[^/]*(/|$)'
TRUSTED_ASSOCIATIONS="OWNER MEMBER COLLABORATOR"
INTAKE_CAP=40
STALE_CLAIM_DAYS=3
ISSUE_CLASSIFIER=""
CLUSTER_MAX_ISSUES=4
CLUSTER_MAX_LINES=400
EVIDENCE_LINE_SLACK=3
EVIDENCE_MIN_QUOTE=8
UNIT_PERMISSIONS="triage readers: Read, Grep, Glob only"
