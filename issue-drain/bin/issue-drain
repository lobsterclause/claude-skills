#!/bin/bash
# issue-drain launcher. The skill is installed as a symlink, so follow links to
# find the crate, build it (a no-op when nothing changed), then run the binary.
# Works in bash 3.2 and when called by any path.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
crate="$(cd -P "$(dirname "$src")/.." && pwd)"

export ISSUE_DRAIN_SKILL_DIR="${ISSUE_DRAIN_SKILL_DIR:-$crate}"

if ! command -v cargo >/dev/null 2>&1; then
  echo "issue-drain: cargo is not installed; install Rust from https://rustup.rs" >&2
  exit 1
fi

# One target folder, named in full, for the build and for the exec. A relative
# CARGO_TARGET_DIR means relative to where the caller stands.
target="${CARGO_TARGET_DIR:-$crate/target}"
case "$target" in /*) ;; *) target="$PWD/$target" ;; esac

# The build runs from the crate, not from the caller's folder. Cargo reads
# .cargo/config.toml upward from where it is started, and the caller's folder
# is the repo being drained: its config could name a build wrapper or a linker,
# which would then run as part of this build. A build target set in the
# environment would also put the binary somewhere the exec does not look.
# Build output goes to stderr only: stdout belongs to the subcommand.
if ! (cd "$crate" && env -u CARGO_BUILD_TARGET cargo build --release --locked --quiet --target-dir "$target") >&2; then
  echo "issue-drain: the build failed; run cargo build --release in $crate to see why" >&2
  exit 1
fi

exec "$target/release/issue-drain" "$@"
